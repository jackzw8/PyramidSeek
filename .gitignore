# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
*.egg-info/

# 本地运行产物（中间库/缓存）；只锚定仓库根目录的 data/，保留目录占位
/data/*
!/data/.gitkeep

# 评分产物由 batch 生成（家法 R22）；按 R21（V1.3 / ADR-014）随前端一起
# 由 publish 推到 **gh-pages** 快照分支，不进 main
/public/data/*.json
/public/data/ranking/
/public/data/stock/
!/public/data/.gitkeep

# 发布构建物（M5-6 publish 生成，整目录推 gh-pages）
/dist/

# 跑批控制台运行记录（M5-4 运行时生成）
/console/runs.db

# 选样清单（data/lists/）由控制台生成、每次重写 → 不入库
# （清单确定性来自「按代码序取前 N」，随时可重新生成；`/data/*` 已在上面整体忽略）
# 注：旧 `batch/` 目录（选样脚本 + 清单）已于 2026-11-04 删除，功能并入控制台

# 编辑器 / 系统
.vscode/
.idea/
.DS_Store
Thumbs.db
